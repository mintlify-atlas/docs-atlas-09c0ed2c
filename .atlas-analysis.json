  "keyFeatures": [
    "App Router with React Server Components",
    "File-based routing with layouts, pages, and route handlers",
    "Server-side rendering (SSR) and static site generation (SSG)",
    "Incremental Static Regeneration (ISR)",
    "Built-in image, font, and script optimization",
    "Turbopack bundler for fast development builds",
    "Middleware and Edge Runtime support",
    "TypeScript support out of the box",
    "Automatic code splitting and prefetching",
    "Built-in CSS, Sass, and Tailwind CSS support",
    "API Routes and Route Handlers",
    "Streaming and Suspense support"
  ],
  "publicApiSurface": [
    "next/image — Image component with automatic optimization",
    "next/link — Client-side navigation Link component",
    "next/font — Font optimization with Google Fonts and local fonts",
    "next/script — Script loading with strategies",
    "next/navigation — useRouter, usePathname, useParams, useSearchParams",
    "next/headers — cookies(), headers() server functions",
    "next/cache — revalidatePath(), revalidateTag(), cacheLife(), cacheTag()",
    "next/server — NextRequest, NextResponse, middleware support",
    "next/og — ImageResponse for Open Graph images",
    "create-next-app — CLI scaffolding tool",
    "next dev / next build / next start / next lint — CLI commands",
    "next.config.js — Framework configuration file",
    "generateStaticParams() — Static parameter generation",
    "generateMetadata() — Dynamic metadata generation",
    "Route Segment Config — layout.tsx/page.tsx export constants",
    "Server Actions — Form mutations with use server directive"
  ]
}
